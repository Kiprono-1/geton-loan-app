# GETON Kenya Frontend — Environment Variables
# ============================================================
# Copy to .env.local for local development
# Set in Vercel dashboard for production
# ============================================================

# Backend API URL
# Local dev: http://localhost:3000/api/v1
# Production: https://api.geton.co.ke/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Public site URL (used in share links, OG, etc.)
# Local dev: http://localhost:5173
# Production: https://geton.co.ke
VITE_SITE_URL=http://localhost:5173

# Optional: Analytics (only in production)
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://...@sentry.io/123

# Optional: Feature flags
# VITE_ENABLE_REFERRAL=true
# VITE_ENABLE_DARK_MODE=false
