# ============== SERVER ==============
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ============== DATABASE ==============
DATABASE_URL="file:./dev.db"

# ============== AUTH ==============
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-64-byte-random-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-64-byte-random-hex-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============== PAYSTACK (M-PESA STK PUSH) ==============
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=replace-me-with-your-paystack-webhook-secret

# ============== SAFARICOM DARAPA (Optional, for native STK) ==============
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=

# ============== CRB (Credit Reference Bureau) ==============
# TransUnion, Metropol, or Creditinfo API keys
CRB_PROVIDER=transunion
CRB_API_KEY=
CRB_API_URL=

# ============== SMS (Africa's Talking) ==============
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=GETON

# ============== EMAIL ==============
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=no-reply@geton.co.ke
